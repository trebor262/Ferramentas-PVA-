# Copie para .env e preencha. NUNCA suba o .env para o GitHub (já está no .gitignore).
# Os segredos (SENHAS e CHAVES) são gerados por: scripts/gen-secrets.sh

# ---------- Endereços ----------
CAL_HOST=agenda.robertrochateraoeuta.com.br
CHATWOOT_HOST=atendimento.robertrochateraoeuta.com.br
SITE_URL=https://robertrochateraoeuta.com.br
TIMEZONE=America/Sao_Paulo
ACME_EMAIL=troque-por-seu-email@exemplo.com.br

# ---------- E-mail (SMTP) ----------
# Use um serviço de envio (ex.: Brevo, Amazon SES, Resend, Zoho) e configure SPF/DKIM do domínio.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_DOMAIN=robertrochateraoeuta.com.br
MAIL_FROM_ADDRESS=agenda@robertrochateraoeuta.com.br
MAIL_FROM_NAME=Clínica
MAIL_FROM=Clínica <agenda@robertrochateraoeuta.com.br>

# ---------- Segredos (gerados por scripts/gen-secrets.sh) ----------
CAL_DB_PASSWORD=
NEXTAUTH_SECRET=
CALENDSO_ENCRYPTION_KEY=
CHATWOOT_DB_PASSWORD=
CHATWOOT_REDIS_PASSWORD=
CHATWOOT_SECRET_KEY_BASE=
CAL_WEBHOOK_SECRET=

# ---------- Preencher depois de criar o administrador do Chatwoot ----------
# Chatwoot > Perfil (canto inferior esquerdo) > Configurações do perfil > Token de acesso
CHATWOOT_API_TOKEN=

# ---------- Preencher depois de criar o administrador do cal.diy ----------
CAL_USERNAME=clinica
